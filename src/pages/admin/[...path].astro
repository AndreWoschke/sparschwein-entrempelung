---
import "../../index.css";
import AdminApp from "@/react-app/AdminApp";

// Bekannte Admin-Routen vorab rendern; die SPA navigiert clientseitig weiter.
export function getStaticPaths() {
  return [
    { params: { path: undefined } }, // /admin
    { params: { path: "login" } },
    { params: { path: "angebot" } },
    { params: { path: "verlauf" } },
    { params: { path: "einstellungen" } },
    { params: { path: "team" } },
    { params: { path: "performance" } },
    { params: { path: "seo" } },
  ];
}
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin | Sparschwein Entrümpelung</title>
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    {/* Komplette Admin-SPA – nur clientseitig (Supabase-Auth, React Router) */}
    <AdminApp client:only="react" />
  </body>
</html>
