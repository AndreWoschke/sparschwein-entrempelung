---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 – Seite nicht gefunden | Sparschwein Entrümpelung"
  description="Diese Seite wurde leider nicht gefunden."
  robots="noindex, follow"
>
  <div class="flex min-h-[50vh] items-center justify-center px-4">
    <div class="text-center">
      <h1 class="mb-4 text-5xl font-bold">404</h1>
      <p class="mb-6 text-xl text-muted-foreground">Diese Seite wurde leider nicht gefunden.</p>
      <a href="/" class="text-primary underline hover:text-primary/90">Zurück zur Startseite</a>
    </div>
  </div>
</BaseLayout>
